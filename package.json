{
  "name": "little-bot",
  "productName": "Little Bot",
  "version": "0.52.0",
  "private": true,
  "description": "A focused local Windows assistant for chat, files, commands, and scheduled tasks.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "check:syntax": "node scripts/check-syntax.cjs",
    "test": "node --test test/*.test.cjs",
    "test:electron": "electron test/embedded-browser-electron.cjs && electron test/widget-window-electron.cjs && electron test/cad-kernel-electron.cjs",
    "ci": "npm run check:syntax && npm test && npm run test:electron",
    "package": "node scripts/package.cjs",
    "package:portable": "node scripts/package.cjs --portable-only",
    "build:icons": "electron scripts/build-icons.cjs",
    "prepare:embeddings": "node scripts/prepare-embeddings.cjs",
    "pretest": "npm run prepare:embeddings",
    "prestart": "npm run prepare:embeddings"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "2.20.1",
    "@huggingface/tokenizers": "0.2.0",
    "@mozilla/readability": "0.6.0",
    "acorn": "8.19.0",
    "linkedom": "0.18.13",
    "mammoth": "1.12.3",
    "onnxruntime-node": "1.30.0",
    "qrcode-generator": "2.0.4",
    "replicad": "1.1.0",
    "replicad-opencascadejs": "1.1.0",
    "three": "0.186.1",
    "turndown": "7.2.4",
    "turndown-plugin-gfm": "1.0.2",
    "unpdf": "1.8.1",
    "webtorrent": "3.0.21"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.4.5"
  }
}
