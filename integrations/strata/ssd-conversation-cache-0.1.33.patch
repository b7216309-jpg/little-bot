+// Private, process-lifetime files. No serialized state is reused after restart.
+// Payload hashes are kept in memory and checked before any GPU restore.
+class ConversationTempFile {
+public:
+    static constexpr size_t chunk_bytes = 1024 * 1024;
+    static constexpr uint64_t free_floor = 512ull * 1024 * 1024;
+    static std::optional<uint64_t> available_bytes() {
+#if defined(_WIN32)
+        wchar_t directory[MAX_PATH + 1];
+        const DWORD length = GetTempPathW(MAX_PATH, directory);
+        ULARGE_INTEGER available;
+        if (!length || length >= MAX_PATH || !GetDiskFreeSpaceExW(directory, &available, nullptr, nullptr))
+            return std::nullopt;
+        return available.QuadPart;
+#else
+        std::error_code error;
+        const auto space = std::filesystem::space(P_tmpdir, error);
+        if (error) return std::nullopt;
+        return space.available;
+#endif
+    }
+    static bool space_admit(std::optional<uint64_t> available, uint64_t allocation) {
+        return available && *available >= free_floor && allocation <= *available - free_floor;
+    }
+    ConversationTempFile() {
+#if defined(_WIN32)
+        wchar_t directory[MAX_PATH + 1], name[MAX_PATH + 1];
+        const DWORD length = GetTempPathW(MAX_PATH, directory);
+        if (!length || length >= MAX_PATH || !GetTempFileNameW(directory, L"stc", 0, name))
+            throw std::runtime_error("SSD cache: cannot create temporary file");
+        HANDLE handle = CreateFileW(name, GENERIC_READ | GENERIC_WRITE, 0, nullptr, OPEN_EXISTING,
+                                   FILE_ATTRIBUTE_TEMPORARY | FILE_FLAG_DELETE_ON_CLOSE, nullptr);
+        if (handle == INVALID_HANDLE_VALUE) {
+            DeleteFileW(name);
+            throw std::runtime_error("SSD cache: cannot open temporary file");
+        }
+        const int fd = _open_osfhandle(reinterpret_cast<intptr_t>(handle), _O_BINARY | _O_RDWR);
+        if (fd < 0) { CloseHandle(handle); throw std::runtime_error("SSD cache: file descriptor failed"); }
+        file_ = _fdopen(fd, "w+b");
+        if (!file_) { _close(fd); throw std::runtime_error("SSD cache: file stream failed"); }
+#else
+        file_ = std::tmpfile();
+        if (!file_) throw std::runtime_error("SSD cache: cannot create temporary file");
+#endif
+        // The explicit staging chunk owns buffering; avoid another CRT buffer.
+        std::setvbuf(file_, nullptr, _IONBF, 0);
+        ++files_;
+    }
+    ~ConversationTempFile() { if (file_) { std::fclose(file_); --files_; } }
+    static size_t active_files() { return files_.load(); }
+    ConversationTempFile(const ConversationTempFile&) = delete;
+    ConversationTempFile& operator=(const ConversationTempFile&) = delete;
+    size_t size() const { return size_; }
+    size_t ram_bytes() const { return hashes_.capacity() * sizeof(uint64_t); }
+    void read(void* destination, size_t at, size_t count) const {
+        if (at > size_ || count > size_ - at) throw std::runtime_error("SSD cache: invalid read extent");
+        seek(at);
+        if (count && std::fread(destination, 1, count, file_) != count)
+            throw std::runtime_error("SSD cache: incomplete read");
+    }
+    void write(const void* source, size_t at, size_t count) {
+        if (count > SIZE_MAX - at || at > size_) throw std::runtime_error("SSD cache: invalid write extent");
+        seek(at);
+        if (count && std::fwrite(source, 1, count, file_) != count)
+            throw std::runtime_error("SSD cache: incomplete write");
+        size_ = std::max(size_, at + count);
+        sealed_ = false;
+    }
+    void resize(size_t n, uint8_t value = 0) {
+        if (n > size_) {
+            std::vector<uint8_t> buffer(std::min(chunk_bytes, n - size_), value);
+            while (size_ < n) write(buffer.data(), size_, std::min(buffer.size(), n - size_));
+        } else if (n < size_) {
+            if (std::fflush(file_)) throw std::runtime_error("SSD cache: flush failed");
+#if defined(_WIN32)
+            if (_chsize_s(_fileno(file_), n)) throw std::runtime_error("SSD cache: truncate failed");
+#else
+            if (ftruncate(fileno(file_), n)) throw std::runtime_error("SSD cache: truncate failed");
+#endif
+            size_ = n;
+            sealed_ = false;
+        }
+    }
+    void seal() {
+        if (std::fflush(file_)) throw std::runtime_error("SSD cache: flush failed");
+        hashes_.clear();
+        std::vector<uint8_t> buffer(std::min(size_, chunk_bytes));
+        for (size_t at = 0; at < size_;) {
+            const size_t n = std::min(buffer.size(), size_ - at);
+            read(buffer.data(), at, n);
+            hashes_.push_back(hash(buffer.data(), n));
+            at += n;
+        }
+        sealed_ = true;
+    }
+    bool verify() const {
+        if (!sealed_) return false;
+        try {
+            seek(0);
+#if defined(_WIN32)
+            if (_fseeki64(file_, 0, SEEK_END) || _ftelli64(file_) != static_cast<int64_t>(size_)) return false;
+#else
+            if (fseeko(file_, 0, SEEK_END) || ftello(file_) != static_cast<int64_t>(size_)) return false;
+#endif
+            std::vector<uint8_t> buffer(std::min(size_, chunk_bytes));
+            size_t index = 0;
+            for (size_t at = 0; at < size_;) {
+                const size_t n = std::min(buffer.size(), size_ - at);
+                read(buffer.data(), at, n);
+                if (index >= hashes_.size() || hash(buffer.data(), n) != hashes_[index++]) return false;
+                at += n;
+            }
+            return index == hashes_.size();
+        } catch (const std::runtime_error&) { return false; }
+    }
+private:
+    inline static std::atomic<size_t> files_{0};
+    void seek(size_t at) const {
+        if (at > INT64_MAX) throw std::runtime_error("SSD cache: file offset overflow");
+#if defined(_WIN32)
+        if (_fseeki64(file_, static_cast<int64_t>(at), SEEK_SET))
+#else
+        if (fseeko(file_, static_cast<off_t>(at), SEEK_SET))
+#endif
+            throw std::runtime_error("SSD cache: seek failed");
+    }
+    static uint64_t hash(const uint8_t* p, size_t n) {
+        uint64_t h = 1469598103934665603ull;
+        while (n >= sizeof(uint64_t)) {
+            uint64_t word;
+            std::memcpy(&word, p, sizeof(word));
+            h = (h ^ word) * 1099511628211ull;
+            p += sizeof(word); n -= sizeof(word);
+        }
+        while (n--) h = (h ^ *p++) * 1099511628211ull;
+        return h;
+    }
+    FILE* file_ = nullptr;
+    size_t size_ = 0;
+    std::vector<uint64_t> hashes_;
+    bool sealed_ = false;
+};
+
+inline thread_local bool conversation_capture_to_ssd = false;
+struct ConversationStorageScope {
+    bool previous;
+    explicit ConversationStorageScope(bool disk) : previous(conversation_capture_to_ssd) { conversation_capture_to_ssd = disk; }
+    ~ConversationStorageScope() { conversation_capture_to_ssd = previous; }
+};
+
+} // namespace strata::core
